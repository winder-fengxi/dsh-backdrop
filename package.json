{
  "name": "dsh-backdrop",
  "version": "0.1.0",
  "description": "Wallpaper and per-section background images for the DeepSeek Harness web UI: one overall background, plus an optional image for the left sidebar, the main area and the right sidebar — each with its own opacity, display mode, alignment and effects.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "background",
    "backdrop",
    "wallpaper",
    "customization",
    "theme"
  ],
  "license": "MIT",
  "type": "module",
  "private": true,
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "test": "node tools/smoke-client.cjs",
    "build:release": "node tools/build-release.mjs",
    "prepublishOnly": "node tools/refuse-direct-publish.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winder-fengxi/dsh-backdrop.git"
  },
  "bugs": {
    "url": "https://github.com/winder-fengxi/dsh-backdrop/issues"
  },
  "homepage": "https://github.com/winder-fengxi/dsh-backdrop#readme"
}
